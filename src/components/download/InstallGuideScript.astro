<script>
  const INSTALLER_PATTERN = /astra\.installer(-arm64)?\.exe/i
  const GITHUB_INSTALLER_PATTERN = /github\.com\/.*\/releases\/.*\/download\/.*\.exe/i

  let pendingDownloadUrl: string | null = null
  let toastTimer: number | undefined

  function isWindowsInstallerLink(link: HTMLAnchorElement): boolean {
    if (!link.href) return false

    try {
      const url = new URL(link.href)
      const filename = url.pathname.split('/').pop() ?? ''
      return INSTALLER_PATTERN.test(filename) || GITHUB_INSTALLER_PATTERN.test(link.href)
    } catch {
      return INSTALLER_PATTERN.test(link.href)
    }
  }

  function getElements() {
    return {
      root: document.getElementById('install-guide-root'),
      panel: document.getElementById('install-guide-panel'),
      backdrop: document.getElementById('install-guide-backdrop'),
      closeButton: document.getElementById('install-guide-close'),
      continueButton: document.getElementById('install-guide-continue'),
      toast: document.getElementById('install-guide-toast'),
      toastClose: document.getElementById('install-guide-toast-close'),
    }
  }

  function triggerDownload(url: string) {
    const anchor = document.createElement('a')
    anchor.href = url
    anchor.rel = 'noopener'
    anchor.download = ''
    document.body.appendChild(anchor)
    anchor.click()
    anchor.remove()
  }

  function showToast() {
    const { toast } = getElements()
    if (!toast) return

    toast.hidden = false
    toast.classList.add('is-visible')

    window.clearTimeout(toastTimer)
    toastTimer = window.setTimeout(() => {
      hideToast()
    }, 12000)
  }

  function hideToast() {
    const { toast } = getElements()
    if (!toast) return

    toast.classList.remove('is-visible')
    window.setTimeout(() => {
      toast.hidden = true
    }, 250)
  }

  function openInstallGuide(downloadUrl: string) {
    const { root, panel } = getElements()
    if (!root || !panel) {
      triggerDownload(downloadUrl)
      return
    }

    pendingDownloadUrl = downloadUrl
    root.hidden = false
    root.setAttribute('aria-hidden', 'false')
    root.classList.add('is-open')
    document.body.style.overflow = 'hidden'
    panel.focus()
    triggerDownload(downloadUrl)
    showToast()
  }

  function closeInstallGuide() {
    const { root } = getElements()
    if (!root) return

    root.classList.remove('is-open')
    root.setAttribute('aria-hidden', 'true')
    document.body.style.overflow = ''
    pendingDownloadUrl = null

    window.setTimeout(() => {
      root.hidden = true
    }, 250)
  }

  function bindInstallGuide() {
    const { root, backdrop, closeButton, continueButton, toastClose } = getElements()
    if (!root) return

    document.querySelectorAll('a[download], a.download-button').forEach(element => {
      if (!(element instanceof HTMLAnchorElement)) return
      if (!isWindowsInstallerLink(element)) return
      if (element.dataset.installGuideBound === 'true') return

      element.dataset.installGuideBound = 'true'
      element.addEventListener(
        'click',
        event => {
          event.preventDefault()
          openInstallGuide(element.href)
        },
        true
      )
    })

    closeButton?.addEventListener('click', closeInstallGuide)
    continueButton?.addEventListener('click', closeInstallGuide)
    backdrop?.addEventListener('click', closeInstallGuide)
    toastClose?.addEventListener('click', hideToast)

    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && root.classList.contains('is-open')) {
        closeInstallGuide()
      }
    })
  }

  function start() {
    bindInstallGuide()
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start)
  } else {
    start()
  }
</script>
