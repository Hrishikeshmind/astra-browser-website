<script is:inline data-cfasync="false">
  const GITHUB_REPO = 'Hrishikeshmind/astradesktop'
  const COUNT_API = 'https://api.countapi.xyz'
  const COUNT_NAMESPACE = 'astra-browser-site'
  const COUNT_KEY = 'downloads'
  const REFRESH_MS = 30 * 1000
  const INSTALLER_ASSET_PATTERN = /\.(exe|AppImage|dmg|tar\.xz|zip)$/i

  function isInstallerAsset(filename) {
    return INSTALLER_ASSET_PATTERN.test(filename)
  }

  function isGitHubInstallerLink(link) {
    if (!(link instanceof HTMLAnchorElement) || !link.href) return false
    try {
      const url = new URL(link.href)
      return (
        url.hostname === 'github.com' &&
        url.pathname.includes('/releases/') &&
        url.pathname.includes('/download/')
      )
    } catch {
      return false
    }
  }

  function formatCount(count) {
    return `${count.toLocaleString('en-US')} downloads`
  }

  function updateDisplays(count) {
    const el = document.getElementById('footer-download-count')
    if (!el) return
    el.textContent = formatCount(count)
    el.classList.remove('hidden')
  }

  async function fetchGitHubDownloadCount() {
    let page = 1
    let total = 0

    while (true) {
      const res = await fetch(
        `https://api.github.com/repos/${GITHUB_REPO}/releases?per_page=100&page=${page}`,
        {
          headers: {
            Accept: 'application/vnd.github+json',
            'X-GitHub-Api-Version': '2022-11-28',
          },
        }
      )
      if (!res.ok) return null

      const releases = await res.json()
      if (!Array.isArray(releases) || releases.length === 0) break

      for (const release of releases) {
        for (const asset of release.assets ?? []) {
          if (isInstallerAsset(asset.name ?? '')) {
            total += asset.download_count ?? 0
          }
        }
      }

      if (releases.length < 100) break
      page += 1
    }

    return total
  }

  async function fetchLiveCount() {
    try {
      const res = await fetch(`${COUNT_API}/get/${COUNT_NAMESPACE}/${COUNT_KEY}`)
      if (!res.ok) return null
      const data = await res.json()
      return typeof data.value === 'number' ? data.value : null
    } catch {
      return null
    }
  }

  async function setLiveCount(value) {
    try {
      const res = await fetch(`${COUNT_API}/set/${COUNT_NAMESPACE}/${COUNT_KEY}/${value}`)
      if (!res.ok) return null
      const data = await res.json()
      return typeof data.value === 'number' ? data.value : value
    } catch {
      return null
    }
  }

  async function incrementLiveCount() {
    try {
      const res = await fetch(`${COUNT_API}/hit/${COUNT_NAMESPACE}/${COUNT_KEY}`)
      if (!res.ok) return null
      const data = await res.json()
      return typeof data.value === 'number' ? data.value : null
    } catch {
      return null
    }
  }

  async function syncDownloadCount() {
    const [githubCount, liveCount] = await Promise.all([fetchGitHubDownloadCount(), fetchLiveCount()])

    let display = Math.max(githubCount ?? 0, liveCount ?? 0)

    if (githubCount != null && (liveCount == null || liveCount < githubCount)) {
      const synced = await setLiveCount(githubCount)
      if (synced != null) {
        display = synced
      } else {
        display = githubCount
      }
    }

    updateDisplays(display)
    return display
  }

  function bindDownloadTriggers() {
    document.querySelectorAll('a[download], a.download-button').forEach(el => {
      if (!(el instanceof HTMLAnchorElement)) return
      if (!isGitHubInstallerLink(el)) return
      if (el.dataset.downloadTrackBound === 'true') return
      el.dataset.downloadTrackBound = 'true'

      el.addEventListener('click', async () => {
        const next = await incrementLiveCount()
        if (next != null) {
          updateDisplays(next)
        }

        window.setTimeout(syncDownloadCount, 15 * 1000)
        window.setTimeout(syncDownloadCount, 60 * 1000)
        window.setTimeout(syncDownloadCount, 3 * 60 * 1000)
      })
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      bindDownloadTriggers()
      syncDownloadCount()
    })
  } else {
    bindDownloadTriggers()
    syncDownloadCount()
  }

  setInterval(syncDownloadCount, REFRESH_MS)
</script>
