---
interface Props {
  src: string
  alt: string
  class?: string
}

const { src, alt, class: className } = Astro.props
---

<div
  class:list={[
    'feature-visual grid-line grid-line-all flex aspect-[16/10] w-full items-center justify-center bg-subtle',
    className,
  ]}
>
  <img src={src} alt={alt} class="h-24 w-24 object-contain lg:h-32 lg:w-32" loading="lazy" decoding="async" />
</div>
