---
import GridDivider from '~/components/GridDivider.astro'
import ContentPage from '~/components/ContentPage.astro'
import Layout from '~/layouts/Layout.astro'
import { getLocale, getUI } from '~/utils/i18n'

export { getStaticPaths } from '~/utils/i18n'

const locale = getLocale(Astro)
const { layout } = getUI(locale)

const GITHUB_PROFILE = 'https://github.com/Hrishikeshmind'
const EMAIL = 'astrabrowserdev@gmail.com'

const channels = [
  {
    title: 'GitHub',
    body: 'For bugs, feature ideas, and technical questions, GitHub is the best place to reach the project. You can open an issue or start a discussion on the astradesktop repository.',
    href: GITHUB_PROFILE,
    cta: 'View GitHub profile',
  },
  {
    title: 'Email',
    body: 'For direct inquiries about Astra Browser, partnerships, or press — send a message and we will get back to you when we can.',
    href: `mailto:${EMAIL}`,
    cta: EMAIL,
  },
]
---

<Layout title={layout.contact.title} description={layout.contact.description}>
  <ContentPage
    label="Company"
    title="Contact"
    description="Get in touch with the people behind Astra Browser."
  >
    <GridDivider />
    <section class="grid-line grid-line-b">
      <div class="container py-16 lg:py-20">
        <div class="grid gap-6 lg:grid-cols-2">
          {
            channels.map(channel => (
              <article class="grid-line grid-line-all p-6 lg:p-8">
                <h2 class="mb-3 text-lg font-bold tracking-tight uppercase">{channel.title}</h2>
                <p class="mb-6 text-sm leading-relaxed text-gray">{channel.body}</p>
                <a
                  href={channel.href}
                  target={channel.href.startsWith('http') ? '_blank' : undefined}
                  rel={channel.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="footer-link text-sm font-medium"
                >
                  {channel.cta} →
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <GridDivider />
    <section>
      <div class="container py-16 lg:py-20">
        <p class="text-sm leading-relaxed text-gray">
          Looking for community help or want to report a bug? Visit the{' '}
          <a href="/community" class="footer-link">
            community page
          </a>{' '}
          for Discussions, Issues, Discord, and release updates.
        </p>
      </div>
    </section>
  </ContentPage>
</Layout>
